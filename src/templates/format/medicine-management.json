{
  "id": "medicine-management",
  "name": "Medicine Management Follow-up",
  "description": "Standard template for psychiatric medication management visits",
  "version": "1.0",
  "sections": [
    {
      "id": "identification",
      "title": "Identification",
      "required": true,
      "format": "paragraph",
      "patterns": ["^identification", "^patient", "^\\w+ \\w+ is a \\d+"],
      "description": "Patient demographics and history",
      "example": "John Smith is a 14 year old male with a history of ADHD and Major Depressive Disorder. He is in the 7th grade."
    },
    {
      "id": "cc",
      "title": "CC",
      "required": true,
      "format": "single-line",
      "patterns": ["^chief complaint", "^cc", "^follow[- ]?up"],
      "description": "Chief complaint",
      "example": "Follow-up"
    },
    {
      "id": "problem-list",
      "title": "Problem List",
      "required": true,
      "format": "numbered-list",
      "patterns": ["^problem list", "^problemist", "^problems"],
      "itemFormat": "{Diagnosis} – {status}",
      "description": "Active diagnoses with status",
      "example": [
        "ADHD – improving, partial control",
        "Major Depressive Disorder – stable"
      ]
    },
    {
      "id": "current-meds",
      "title": "Current Meds",
      "required": true,
      "format": "numbered-list",
      "patterns": ["^current med", "^current medication", "^medications"],
      "itemFormat": "{Name} {Dosage} ({Frequency})",
      "description": "Current medications",
      "example": [
        "Lexapro 20mg (one pill per day)",
        "Jornay PM 60mg (QHS)"
      ]
    },
    {
      "id": "interim-history",
      "title": "Interim History",
      "required": true,
      "format": "bullet-list",
      "patterns": ["^interim history", "^interim"],
      "description": "Clinical updates since last visit",
      "example": [
        "ADHD in fair control in the interim period",
        "Mood: okay, interest: good, energy: good, concentration: fair, appetite: unchanged",
        "No suicidal thoughts. Finds Lexapro helpful",
        "More social interactions in the interim"
      ]
    },
    {
      "id": "past-medical-history",
      "title": "Past Medical History",
      "required": false,
      "format": "paragraph",
      "patterns": ["^past medical", "^pmh", "^past history"],
      "autoFill": false,
      "description": "Past medical history updates"
    },
    {
      "id": "social-history",
      "title": "Social History",
      "required": false,
      "format": "paragraph",
      "patterns": ["^social history", "^social"],
      "autoFill": false,
      "description": "Social history updates"
    },
    {
      "id": "family-history",
      "title": "Family History",
      "required": false,
      "format": "paragraph",
      "patterns": ["^family history", "^family"],
      "autoFill": false,
      "description": "Family history updates"
    },
    {
      "id": "ros",
      "title": "ROS",
      "required": true,
      "format": "bullet-list",
      "patterns": ["^ros", "^review of systems"],
      "description": "Review of systems",
      "autoFill": false
    },
    {
      "id": "vitals",
      "title": "Vitals",
      "required": false,
      "format": "paragraph",
      "patterns": ["^vital", "^bp", "^blood pressure"],
      "description": "Vital signs",
      "example": "Vital signs are stable.\nMM/DD/YYYY Height: X, Weight: X, BP: X, HR: X."
    },
    {
      "id": "mse",
      "title": "MSE",
      "required": true,
      "format": "paragraph",
      "patterns": ["^mse", "^mental status"],
      "description": "Mental status examination",
      "templateSpecific": ["Include both suicidal and homicidal ideation assessment"]
    },
    {
      "id": "risk-assessment",
      "title": "Risk Assessment",
      "required": true,
      "format": "paragraph",
      "patterns": ["^risk assessment", "^risk"],
      "description": "Risk assessment",
      "templateSpecific": ["Use 'imminently' not 'immediately' for risk timing"]
    },
    {
      "id": "assessment",
      "title": "Assessment",
      "required": true,
      "format": "bullet-list",
      "patterns": ["^assessment", "^clinical assessment"],
      "description": "Clinical assessment points",
      "constraints": ["Use Title Case for diagnoses"]
    },
    {
      "id": "plan",
      "title": "Plan",
      "required": true,
      "format": "bullet-list",
      "patterns": ["^plan", "^treatment plan"],
      "description": "Treatment plan",
      "autoFill": false
    },
    {
      "id": "therapy-notes",
      "title": "Therapy Notes",
      "required": false,
      "format": "paragraph",
      "patterns": ["^therapy notes", "^therapy"],
      "autoFill": false,
      "description": "Additional therapy notes"
    }
  ],
  "formatting": {
    "sectionHeaderLevel": 3,
    "sectionHeaderPrefix": "###",
    "sectionSeparator": "\n\n",
    "listItemPrefix": {
      "numbered": "{n}. ",
      "bullet": "- "
    },
    "medicationFormat": "{Name} {Dosage} ({Frequency})",
    "problemFormat": "{Diagnosis} – {status}",
    "signatureFormat": "*Signed by {Name}, MD on {Date}*",
    "dateFormat": "MMM/DD/YYYY",
    "listSeparators": {
      "problem": " – ",
      "medication": " ",
      "default": ": "
    }
  },
  "templateSpecificRules": [
    {
      "section": "Problem List",
      "rule": "Use numbered list with diagnosis – status format"
    },
    {
      "section": "Current Meds", 
      "rule": "Format as: Name Dosage (frequency in patient's words)"
    },
    {
      "section": "Interim History",
      "rule": "Use bullet points for clinical observations"
    },
    {
      "section": "MSE",
      "rule": "Include both suicidal and homicidal ideation assessment"
    },
    {
      "section": "Risk Assessment",
      "rule": "Use 'imminently' not 'immediately' for risk timing"
    }
  ]
}
